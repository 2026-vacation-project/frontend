# 개발 환경에서는 비워 두면 Vite가 백엔드(127.0.0.1:8000)로 프록시합니다.
VITE_API_BASE_URL=

VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here

# ../backend/.env의 GOOGLE_REDIRECT_URI / DISCORD_REDIRECT_URI와 일치해야 합니다.
VITE_OAUTH_REDIRECT_BASE_URL=http://localhost:3000/auth/callback

# Firebase 웹 앱 설정 및 Cloud Messaging Web Push 인증서 공개 키
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_VAPID_KEY=your_public_vapid_key
